# FlowCortex EC2 deploy — copy to host.env and adjust.
#   cp deploy/ec2/host.env.example deploy/ec2/host.env
#
# Same R&D host as eGenie / WiseEars by default.

# SSH
export DEPLOY_HOST="${DEPLOY_HOST:-100.52.147.238}"
export DEPLOY_KEY="${DEPLOY_KEY:-/Users/vijay/rnd/projects/VeerSetuHost.pem}"
export DEPLOY_USER="${DEPLOY_USER:-ubuntu}"

# Public URLs (Caddy TLS)
export FC_PUBLIC_URL="${FC_PUBLIC_URL:-https://flowcortex.veerlabs.solutions}"
export FC_API_PUBLIC_URL="${FC_API_PUBLIC_URL:-https://flowcortex-api.veerlabs.solutions}"

# Ports on shared EC2 (localhost; Caddy terminates TLS)
# 8080=WiseEars, 8081=eGenie, 8090=Srotiva, 6060=EdgeFabric, 8180=KeyCortex, 8190=Velocity
export FC_L1_PORT="${FC_L1_PORT:-8200}"
export FC_EXPLORER_PORT="${FC_EXPLORER_PORT:-8201}"
export FC_GRPC_PORT="${FC_GRPC_PORT:-50052}"

# Linux build routing (same as eGenie: EC2 when up, else LAN .78)
export BUILD_MODE="${BUILD_MODE:-auto}"
export BUILD_HOST="${BUILD_HOST:-vijay@192.168.29.78}"
export BUILD_ROOT="${BUILD_ROOT:-/home/vijay/flowcortex-ec2-build}"

# Optional overrides
# export FLOWCORTEX_ROOT=/path/to/flow-cortex
# export FORCE_BUILD=1
# export SKIP_BUILD=1
# export DEPLOY_EXPLORER=0          # L1 API only (no Explorer UI)
